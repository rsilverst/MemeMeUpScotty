<resources>

    <!-- Post-splash theme used by the activity once Compose has rendered. -->
    <style name="Theme.MemeMeUpScotty" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/space_900</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Starting theme: shown by the system between cold-launch click and first
         frame of Compose. AndroidX SplashScreen API backports the Android 12+
         behavior down to API 23. -->
    <style name="Theme.MemeMeUpScotty.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/space_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MemeMeUpScotty</item>
    </style>
</resources>
